pageType: content
background:
  type: solid
  color: "#FFFFFF"
elements:
  - elementId: kicker
    elementType: text
    bounds: [48, 26, 420, 14]
    content: {style: "$kicker", wrap: false, align: [left, middle], text: TIER 1 · 第一梯队}
  - elementId: nav
    elementType: text
    bounds: [480, 24, 432, 14]
    content:
      style: "$nav"
      wrap: false
      align: [right, middle]
